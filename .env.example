# Copiar a .env.local (nunca commitear .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

OPEN_METEO_API_KEY=          # vacío en desarrollo (plan gratuito); completar al contratar el plan comercial
ANTHROPIC_API_KEY=           # Hito 5 (chatbot)
HANDY_WEBHOOK_URL=           # Hito 5
HANDY_HMAC_SECRET=           # Hito 5

APP_URL=                     # URL pública de la app (vacío en Vercel: usa el dominio de producción)
ALLOWED_EMAILS=              # mails habilitados para vincular, separados por coma

# Fuera de .env.local (no van en Vercel):
# - Edge Functions (`supabase secrets set`): CLIMA_CRON_SECRET, CLIMA_TELEGRAM_BOT_TOKEN,
#   CLIMA_OPEN_METEO_API_KEY (opcional, plan comercial).
# - Vault de la base: clima_cron_secret (igual a CLIMA_CRON_SECRET) y clima_functions_url.
# - GitHub Actions (`gh secret set`), worker WRF: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY.
