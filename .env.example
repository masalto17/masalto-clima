# Copiar a .env.local (nunca commitear .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

OPEN_METEO_API_KEY=          # vacío en desarrollo (plan gratuito); completar al contratar el plan comercial
# También se acepta CLIMA_OPEN_METEO_API_KEY (el mismo valor que en las Edge Functions).

# Fuentes opcionales del consenso. Sin estas claves se usan Open-Meteo, MET Norway, SMN y METAR.
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
TOMORROW_API_KEY=

# Registro de aciertos. Alcanza con uno. Sin ninguno la página sigue y las fuentes pesan igual.
BLOB_READ_WRITE_TOKEN=       # Vercel Blob, acceso privado, archivo clima/ledger.json
KV_REST_API_URL=             # Upstash / Vercel KV, alternativa al Blob
KV_REST_API_TOKEN=
CRON_SECRET=                 # lo exige /api/cron/precision en producción. Vercel Cron lo manda solo.

# Cortes del semáforo. Si faltan, valen los de lib/clima/thresholds.ts.
# CLIMA_GUST_ATENCION_KMH=45
# CLIMA_GUST_ALERTA_KMH=65
# CLIMA_WIND_ALERTA_KMH=50
# CLIMA_RAIN_ATENCION_MM=1
# CLIMA_RAIN_ALERTA_MM=10
# CLIMA_RAIN_HOUR_ALERTA_MM=5
# CLIMA_ZONDA_GUST_KMH=50
# CLIMA_ZONDA_GUST_VIGILANCIA_KMH=40
# CLIMA_ZONDA_HUMIDITY_PCT=25
# CLIMA_ZONDA_HUMIDITY_VIGILANCIA_PCT=35
# CLIMA_ZONDA_TEMP_RISE_C=8
# CLIMA_ZONDA_HUMIDITY_DROP=20
# CLIMA_ZONDA_PRESSURE_DROP_HPA=3
ANTHROPIC_API_KEY=           # Hito 5 (chatbot)
HANDY_WEBHOOK_URL=           # Hito 5
HANDY_HMAC_SECRET=           # Hito 5

APP_URL=                     # URL pública de la app (vacío en Vercel: usa el dominio de producción)
ALLOWED_EMAILS=              # mails habilitados para vincular, separados por coma

# Fuera de .env.local (no van en Vercel):
# - Edge Functions (`supabase secrets set`): CLIMA_CRON_SECRET, CLIMA_TELEGRAM_BOT_TOKEN,
#   CLIMA_OPEN_METEO_API_KEY (opcional, plan comercial).
# - Vault de la base: clima_cron_secret (igual a CLIMA_CRON_SECRET) y clima_functions_url.
# - GitHub Actions (`gh secret set`), worker WRF: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY.
